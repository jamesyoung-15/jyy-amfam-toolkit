# Atlassian Cloud base URL (no trailing slash)
JIRA_URL=https://yoururl.atlassian.net

# Email address associated with your Atlassian Cloud account
JIRA_EMAIL=your.email@email.com

# Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# GitLab base URL (no trailing slash). Optional, defaults to https://gitlab.com
GITLAB_URL=https://gitlab.com

# GitLab personal access token with 'api' scope:
# https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=your-gitlab-token-here
